# ────────────────────────────────────────────────
# ECO COMPANY Backend — Environment Variables
# ────────────────────────────────────────────────

# Database (PostgreSQL URL — Northflank, Supabase, Neon yoki Render)
DATABASE_URL=postgresql://USER:PASS@HOST:PORT/ecocompany_db

# JWT (Admin auth uchun xavfsiz kalit)
JWT_SECRET=kamida-32-belgili-tasodifiy-maxfiy-kalit-bu-yerga-yozing
JWT_EXPIRE_DAYS=7

# Email (SMTP — masalan Brevo: smtp-relay.brevo.com:587)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=false
SMTP_START_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@ecocompany.uz
SMTP_FROM_NAME=ECO COMPANY

# Admin
ADMIN_EMAIL=Bahromreyimberganov0311@gmail.com

# Telegram (Buyurtma va murojaat xabarlari uchun)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# AI (DeepSeek / Chatbot)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Media Storage ──
# STORAGE_BACKEND="local" yoki "r2" (Cloudflare R2 uchun "r2" qiling)
STORAGE_BACKEND=r2

# Cloudflare R2 Sozlamalari (STORAGE_BACKEND=r2 bo'lganda kerak)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=ecocompany-media
# R2 Public URL (R2 Custom Domain yoki pub-xxx.r2.dev URL)
R2_PUBLIC_URL=https://media.ecocompany.uz

# Local Media Storage (STORAGE_BACKEND=local bo'lsa ishlatiladi)
MEDIA_ROOT=media
MEDIA_URL_PATH=/media
PUBLIC_BASE_URL=https://your-backend.northflank.app

# Frontend vebsayt domeni (SEO sitemap uchun)
SITE_URL=https://ecocompany.vercel.app

# Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_CACHE_HOURS=6

# CORS — Frontend va Admin panel domenlari (vergul bilan ajratilgan)
ALLOWED_ORIGINS=https://ecocompany.vercel.app,https://ecocompany-admin.vercel.app,http://localhost:8080,http://localhost:8081

# Environment ("development" yoki "production")
ENVIRONMENT=production
