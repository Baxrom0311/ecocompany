# ────────────────────────────────────────────────
# ECO COMPANY Backend — Environment Variables
# ────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://USER:PASS@localhost/ecocompany_db

# JWT
JWT_SECRET=minimum-32-ta-belgi-random-string-bu-yerga-yozing
JWT_EXPIRE_DAYS=7

# Email (SMTP)
SMTP_HOST=mail.ecocompany.uz
SMTP_PORT=587
SMTP_USER=admin@ecocompany.uz
SMTP_PASSWORD=

# Admin
ADMIN_EMAIL=admin@ecocompany.uz

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# AI (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Local media storage
MEDIA_ROOT=media
MEDIA_URL_PATH=/media
PUBLIC_BASE_URL=

# Instagram
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_CACHE_HOURS=6

# CORS
ALLOWED_ORIGINS=https://ecocompany.uz,https://admin.ecocompany.uz

# Environment
ENVIRONMENT=production
